+name: ${COMPOSE_PROJECT_NAME:-ah05}
+
+# Production only. Run with an EC2-local .env file; never commit that file.
+# Only nginx is published to the host. MySQL, Redis, FastAPI, and the worker
+# communicate on the private Compose network.
+services:
+  redis:
+    image: redis:7-alpine
+    restart: unless-stopped
+    command: ["redis-server", "--appendonly", "yes"]
+    volumes:
+      - redis_data:/data
+    networks: [healthcare]
+    healthcheck:
+      test: ["CMD", "redis-cli", "ping"]
+      interval: 10s
+      timeout: 5s
+      retries: 5
+      start_period: 5s
+
+  qdrant:
+    image: qdrant/qdrant:v1.15.5
+    restart: unless-stopped
+    volumes:
+      - qdrant_data:/qdrant/storage
+    networks: [healthcare]
+
+  mysql:
+    image: mysql:8.0
+    restart: unless-stopped
+    environment:
+      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:?DB_ROOT_PASSWORD is required}
+      MYSQL_DATABASE: ${DB_NAME:?DB_NAME is required}
+      MYSQL_USER: ${DB_USER:?DB_USER is required}
+      MYSQL_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD is required}
+      TZ: Asia/Seoul
+    command:
+      - --character-set-server=utf8mb4
+      - --collation-server=utf8mb4_unicode_ci
+      - --port=${DB_PORT:-3306}
+    volumes:
+      - mysql_data:/var/lib/mysql
+    networks: [healthcare]
+    healthcheck:
+      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p$${MYSQL_ROOT_PASSWORD} --silent"]
+      interval: 10s
+      timeout: 5s
+      retries: 10
+      start_period: 30s
+
+  fastapi:
+    image: ${DOCKER_USER:?DOCKER_USER is required}/${DOCKER_REPOSITORY:?DOCKER_REPOSITORY is required}:app-${APP_VERSION:?APP_VERSION is required}
+    restart: unless-stopped
+    env_file:
+      - ${ENV_FILE:-../../.env}
+    environment:
+      ENV: prod
+      DEMO_MODE: "false"
+      DB_HOST: mysql
+      REDIS_HOST: redis
+      DB_GENERATE_SCHEMAS: "false"
+    volumes:
+      - media_volume:/app/media
+      - food_vision_cache:/app/storage/food_vision
+    networks: [healthcare]
+    depends_on:
+      mysql:
+        condition: service_healthy
+      redis:
+        condition: service_healthy
+      qdrant:
+        condition: service_started
+    healthcheck:
+      test: ["CMD", "uv", "run", "--no-sync", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/ready', timeout=3)"]
+      interval: 15s
+      timeout: 5s
+      retries: 10
+      start_period: 45s
+
+  ai-worker:
+    image: ${DOCKER_USER:?DOCKER_USER is required}/${DOCKER_REPOSITORY:?DOCKER_REPOSITORY is required}:ai-${AI_WORKER_VERSION:?AI_WORKER_VERSION is required}
+    restart: unless-stopped
+    env_file:
+      - ${ENV_FILE:-../../.env}
+    environment:
+      DB_HOST: mysql
+      REDIS_HOST: redis
+      MODEL_CACHE_DIR: /app/storage/cache
+    # MODEL_SOURCE_DIR is an EC2-local directory. It must not be a Git-tracked
+    # source directory because it can contain a joblib model artifact.
+    volumes:
+      - ${MODEL_SOURCE_DIR:-./models}:/app/models:ro
+      - model_cache:/app/storage/cache
+    mem_limit: 4g
+    networks: [healthcare]
+    depends_on:
+      mysql:
+        condition: service_healthy
+      redis:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD", "test", "-f", "/tmp/ai-worker-ready"]
+      interval: 15s
+      timeout: 3s
+      retries: 10
+      start_period: 45s
+
+  nginx:
+    image: ${DOCKER_USER:?DOCKER_USER is required}/${DOCKER_REPOSITORY:?DOCKER_REPOSITORY is required}:web-${APP_VERSION:?APP_VERSION is required}
+    restart: unless-stopped
+    volumes:
+      - ../nginx/runtime/default.conf:/etc/nginx/conf.d/default.conf:ro
+      - media_volume:/vol/web/media:ro
+      - certbot_conf:/etc/letsencrypt:ro
+      - certbot_www:/var/www/certbot:ro
+    ports:
+      - "80:80"
+      - "443:443"
+    networks: [healthcare]
+    depends_on:
+      fastapi:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD-SHELL", "nginx -t"]
+      interval: 30s
+      timeout: 5s
+      retries: 3
