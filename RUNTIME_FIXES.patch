@@ -0,0 +1,28 @@
+"""204 authentication responses must not send JSON null on a persistent connection."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from app.apis.v1.auth_routers import change_password, confirm_password_reset, logout
+
+
+class AuthEmptyResponseTests(unittest.IsolatedAsyncioTestCase):
+    def assert_empty_response(self, response):
+        self.assertEqual(response.status_code, 204)
+        self.assertEqual(response.body, b"")
+        self.assertIn('refresh_token=""', response.headers["set-cookie"])
+
+    async def test_logout(self):
+        self.assert_empty_response(await logout(SimpleNamespace(id=1)))
+
+    async def test_password_change(self):
+        service = SimpleNamespace(change_password=AsyncMock())
+        request = SimpleNamespace(current_password="old", new_password="new", new_password_confirmation="new")
+        self.assert_empty_response(await change_password(request, SimpleNamespace(id=1), service))
+        service.change_password.assert_awaited_once()
+
+    async def test_password_reset(self):
+        service = SimpleNamespace(reset_password=AsyncMock())
+        request = SimpleNamespace(token="synthetic", new_password="new", new_password_confirmation="new")
+        self.assert_empty_response(await confirm_password_reset(request, service))
+        service.reset_password.assert_awaited_once()
