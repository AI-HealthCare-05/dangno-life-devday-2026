+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const source = fs.readFileSync(require('node:path').join(__dirname, '../../src/frontend/app.js'), 'utf8');
+
+function harness() {
+  const state = { token: 'account-a', cycle: { cycle_id: 1, user_challenges: [{user_challenge_id: 7}] }, dailyCompleted: new Set(['7']) };
+  const requests = [], dialogs = [], messages = [];
+  let day = '2026-10-09';
+  const context = vm.createContext({state, Number, challengeDay: () => day, isLocalPreview: () => false,
+    api: async (url, options) => { requests.push({url, options}); return {carrot_amount: 55, carrot_balance: 55}; },
+    openChallengeRewardDialog: reward => dialogs.push(reward), showMessage: message => messages.push(message),
+  });
+  for (const name of ['dailyChallengeTargetCount', 'allDailyChallengesCompleted', 'maybeOpenDailyReward']) {
+    const body = source.match(new RegExp(`^(?:async )?function ${name}\\([^]*?^}`, 'm'));
+    assert.ok(body, name); vm.runInContext(body[0], context);
+  }
+  return {context, state, requests, dialogs, messages, setDay: value => {day = value;}};
+}
+
+test('accepted photo completion requests daily reward without writing the log again', async () => {
+  for (const saved of [true, false]) {
+    const h = harness();
+    h.state.recordTarget = {saved, item: {catalog_version: 'evidence-v3'}};
+    let handler;
+    h.context.$ = () => ({addEventListener: (_, fn) => {handler = fn;}});
+    h.context.closeRecordModal = () => {h.state.recordTarget = null;};
+    const body = source.slice(source.indexOf('$("#close-photo-success").addEventListener'));
+    vm.runInContext(body.slice(0, body.indexOf('\n});') + 4), h.context);
+    await handler({});
+    assert.equal(h.requests.length, saved ? 1 : 0);
+    if (saved) assert.equal(h.requests[0].url, '/challenge-rewards/daily/2026-10-09');
+    assert.equal(h.state.recordTarget, null);
+  }
+});
+
+test('failed reward request keeps completion and can be retried', async () => {
+  const h = harness();
+  h.context.api = async () => {throw new Error('offline');};
+  await h.context.maybeOpenDailyReward();
+  assert.ok(h.state.dailyCompleted.has('7'));
+  assert.match(h.messages[0], /실천 기록은 저장됐지만/);
+  h.context.api = async () => ({carrot_amount: 55, carrot_balance: 55});
+  await h.context.maybeOpenDailyReward();
+  assert.equal(h.dialogs.length, 1);
+});
+
+test('duplicate clicks share one pending request and late responses cannot cross account, cycle or day', async () => {
+  for (const change of ['token', 'cycle', 'day']) {
+    const h = harness();
+    let resolve, writes = 0;
+    h.context.api = () => {writes++; return new Promise(r => {resolve = r;});};
+    const pending = h.context.maybeOpenDailyReward();
+    await h.context.maybeOpenDailyReward();
+    assert.equal(writes, 1);
+    if (change === 'token') h.state.token = 'account-b';
+    if (change === 'cycle') h.state.cycle = {cycle_id: 2};
+    if (change === 'day') h.setDay('2026-10-10');
+    resolve({carrot_amount: 55, carrot_balance: 55});
+    await pending;
+    assert.equal(h.dialogs.length, 0);
+    assert.equal(h.state.dailyRewardRequest, null);
+  }
+});
+
+test('an already claimed reward does not display another +55 credit', () => {
+  const nodes = new Map();
+  const $ = id => {if (!nodes.has(id)) nodes.set(id, {showModal() {}, focus() {}}); return nodes.get(id);};
+  const context = vm.createContext({$, Number});
+  const body = source.match(/^function openChallengeRewardDialog\([^]*?^}/m);
+  vm.runInContext(body[0], context);
+  context.openChallengeRewardDialog({already_claimed: true, carrot_amount: 55, carrot_balance: 55});
+  assert.equal($('#challenge-reward-amount').textContent, '오늘 보상 지급 완료');
+  assert.match($('#challenge-reward-balance').textContent, /55개/);
+});
+
+test('unrelated old completions cannot satisfy the current selected challenge', async () => {
+  const h = harness();
+  h.state.dailyCompleted = new Set(['old-id']);
+  await h.context.maybeOpenDailyReward();
+  assert.equal(h.requests.length, 0);
+});
+
+test('a new account can claim while the previous account request is pending', async () => {
+  const h = harness();
+  const resolvers = [];
+  h.context.api = () => new Promise(resolve => resolvers.push(resolve));
+  const first = h.context.maybeOpenDailyReward();
+  h.state.token = 'account-b';
+  const second = h.context.maybeOpenDailyReward();
+  assert.equal(resolvers.length, 2);
+  resolvers[0]({carrot_balance: 1});
+  await first;
+  assert.equal(h.dialogs.length, 0);
+  assert.ok(h.state.dailyRewardRequest);
+  resolvers[1]({carrot_balance: 55});
+  await second;
+  assert.equal(h.dialogs.length, 1);
+  assert.equal(h.dialogs[0].carrot_balance, 55);
+});
