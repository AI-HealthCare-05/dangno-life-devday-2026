OPENAI_VLM_FALLBACK_ENABLED=false

# 위치 기반 근처 의료기관·응급의료기관 조회. EMERGENCY_FACILITY_SEARCH_PROVIDER가
# 기본값 nemc로 동작하므로 NEMC_SERVICE_KEY가 비어 있으면 응급의료기관 조회가
# 502로 실패한다.
MEDICAL_FACILITY_SEARCH_PROVIDER=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
MEDICAL_FACILITY_SEARCH_KEYWORDS=
EMERGENCY_FACILITY_SEARCH_PROVIDER=
NEMC_SERVICE_KEY=

# 건강검진 OCR provider: clova 또는 claude. 원본 검진표는 외부 provider로 전송되므로
# 업로드 전 사용자 동의가 필요하다.
HEALTH_CHECKUP_OCR_PROVIDER=
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
ANTHROPIC_API_KEY=

# password reset email (development returns a test token when SMTP is unused)
FRONTEND_BASE_URL=http://localhost:8001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# 검증·승인된 SHAP 설명만 공개합니다. 로컬 검증 후에만 true로 변경하세요.
XAI_DISPLAY_ALLOWED=false
