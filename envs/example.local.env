AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 식단 사진 인증 CV. 모델 번들은 시작 시 공개 Drive에서 내려받아 SHA-256을 검증합니다.
FOOD_VISION_PROVIDER=local_kfood
KFOOD_DRIVE_FILE_ID=1KvCX9bU9GwZvcvZSl0eYHlZ-yg4UbAjQ
KFOOD_BUNDLE_SHA256=753d7c4d3a7d9f9e074565cda0233179243466129a48830fd299a07a9bf0b96c
KFOOD_BUNDLE_DIR=/app/storage/food_vision/kfood
KFOOD_CLASSIFIER_SHA256=4c4df6ba2b9d3daf77f7ffe107285df17a360342729177d15465ba9872d42726
KFOOD_CLASSIFIER_META_SHA256=a193e1faf4e7c266e0ba4481451ded587fcd01cfc7d89c60d834bac63e14e0b3
KFOOD_SEGMENTER_SHA256=edb7df52467afd02a502d7765ca7ac82e63ad86082c72e18135764f1b1817b52
