HEALTH_EDUCATION_RELEVANCE_THRESHOLD=
HEALTH_EDUCATION_TOP_K=
HEALTH_EDUCATION_MAX_CITATIONS=
HEALTH_EDUCATION_RETRIEVER=memory
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=health_education
QDRANT_API_KEY=

