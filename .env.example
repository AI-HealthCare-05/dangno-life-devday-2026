# 건강교육 RAG(질의응답·퀴즈 근거 검색). 운영에서는 HEALTH_EDUCATION_EMBEDDING_PROVIDER와
# HEALTH_EDUCATION_GENERATION_PROVIDER를 openai로 전환합니다. development로 두면 실제 의미
# 검색이 아닌 해싱 기반 근사치로 동작하므로 운영 배포 전 반드시 확인하세요.
HEALTH_EDUCATION_EMBEDDING_PROVIDER=development
HEALTH_EDUCATION_EMBEDDING_MODEL=text-embedding-3-small
HEALTH_EDUCATION_GENERATION_PROVIDER=development
HEALTH_EDUCATION_TIMEOUT_SECONDS=20
HEALTH_EDUCATION_KEYWORD_WEIGHT=0.5
HEALTH_EDUCATION_EMBEDDING_WEIGHT=0.5
HEALTH_EDUCATION_RELEVANCE_THRESHOLD=0.18
HEALTH_EDUCATION_TOP_K=6
HEALTH_EDUCATION_MAX_CITATIONS=3
HEALTH_EDUCATION_RETRIEVER=memory
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=health_education
QDRANT_API_KEY=

# 위치 기반 근처 의료기관 조회
MEDICAL_FACILITY_SEARCH_PROVIDER=kakao
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
MEDICAL_FACILITY_SEARCH_KEYWORDS=당뇨
EMERGENCY_FACILITY_SEARCH_PROVIDER=nemc
NEMC_SERVICE_KEY=
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
CLOVA_OCR_TIMEOUT_SECONDS=20
CLOVA_OCR_MAX_BYTES=10485760

# 건강검진 OCR provider: clova 또는 claude. 원본 검진표는 외부 provider로 전송되므로 업로드 전 사용자 동의가 필요합니다.
HEALTH_CHECKUP_OCR_PROVIDER=clova
ANTHROPIC_API_KEY=
CLAUDE_OCR_MODEL=claude-haiku-4-5-20251001
CLAUDE_OCR_TIMEOUT_SECONDS=25
CLAUDE_OCR_MAX_BYTES=10485760
